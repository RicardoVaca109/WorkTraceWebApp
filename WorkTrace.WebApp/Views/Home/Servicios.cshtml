@model WorkTrace.WebApp.Models.ServiceViewModel

@{
    ViewData["Title"] = "Gestión de Servicios";
}

<div class="container-fluid py-4">
    <div class="card">
        <div class="card-header d-flex justify-content-between align-items-center">
            <h4 class="mb-0">@ViewData["Title"]</h4>
            <div>
                <button type="button" class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#createServiceModal">
                    <i class="fas fa-plus me-2"></i>Crear Nuevo Servicio
                </button>
                <a asp-action="Index" asp-controller="Home" class="btn btn-secondary">
                    <i class="fas fa-arrow-left me-2"></i>Volver al Panel Principal
                </a>
            </div>
        </div>
        <div class="card-body">
            @if (Model.Services != null && Model.Services.Any())
            {
                <div class="accordion" id="servicesAccordion">
                    @foreach (var service in Model.Services)
                    {
                        <div class="accordion-item">
                            <h2 class="accordion-header" id="heading-@service.Id">
                                <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#collapse-@service.Id" aria-expanded="false" aria-controls="collapse-@service.Id">
                                    @service.Name
                                </button>
                            </h2>
                            <div id="collapse-@service.Id" class="accordion-collapse collapse" aria-labelledby="heading-@service.Id" data-bs-parent="#servicesAccordion">
                                <div class="accordion-body">
                                    <div class="d-flex justify-content-end mb-3">
                                        <button class="btn btn-sm btn-outline-secondary edit-service-btn" data-id="@service.Id">
                                            <i class="fas fa-edit me-1"></i> Editar
                                        </button>
                                    </div>
                                    <p><strong>Descripción:</strong> @service.Description</p>
                                    <h5>Pasos de Instalación</h5>
                                    @if (service.InstallationSteps != null && service.InstallationSteps.Any())
                                    {
                                        <table class="table table-sm table-bordered">
                                            <thead class="table-light">
                                                <tr>
                                                    <th scope="col">Paso</th>
                                                    <th scope="col">Descripción</th>
                                                </tr>
                                            </thead>
                                            <tbody>
                                                @foreach (var step in service.InstallationSteps.OrderBy(s => s.Steps))
                                                {
                                                    <tr>
                                                        <td>@step.Steps</td>
                                                        <td>@step.Description</td>
                                                    </tr>
                                                }
                                            </tbody>
                                        </table>
                                    }
                                    else
                                    {
                                        <p>No hay pasos de instalación definidos para este servicio.</p>
                                    }
                                </div>
                            </div>
                        </div>
                    }
                </div>
            }
            else
            {
                <div class="text-center">
                    <p class="lead">No hay servicios para mostrar.</p>
                </div>
            }
        </div>
    </div>
</div>

<!-- Create Service Modal -->
<div class="modal fade" id="createServiceModal" tabindex="-1" aria-labelledby="createServiceModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <form asp-action="CreateService" method="post">
                <div class="modal-header">
                    <h5 class="modal-title" id="createServiceModalLabel">Crear Nuevo Servicio</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <label asp-for="NewService.Name" class="form-label">Nombre del Servicio</label>
                        <input asp-for="NewService.Name" class="form-control" required />
                    </div>
                    <div class="mb-3">
                        <label asp-for="NewService.Description" class="form-label">Descripción</label>
                        <textarea asp-for="NewService.Description" class="form-control" rows="3" required></textarea>
                    </div>
                    <h5>Pasos de Instalación</h5>
                    <div id="installation-steps-container">
                        <!-- Dynamic steps will be added here -->
                    </div>
                    <button type="button" id="add-step-btn" class="btn btn-sm btn-outline-success mt-2">
                        <i class="fas fa-plus"></i> Añadir Paso
                    </button>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                    <button type="submit" class="btn btn-primary">Crear Servicio</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Edit Service Modal -->
<div class="modal fade" id="editServiceModal" tabindex="-1" aria-labelledby="editServiceModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <form id="editServiceForm">
                <div class="modal-header">
                    <h5 class="modal-title" id="editServiceModalLabel">Editar Servicio</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <input type="hidden" id="edit-service-id" />
                    <div class="mb-3">
                        <label for="edit-service-name" class="form-label">Nombre del Servicio</label>
                        <input type="text" id="edit-service-name" class="form-control" required />
                    </div>
                    <div class="mb-3">
                        <label for="edit-service-description" class="form-label">Descripción</label>
                        <textarea id="edit-service-description" class="form-control" rows="3" required></textarea>
                    </div>
                    <h5>Pasos de Instalación</h5>
                    <div id="edit-installation-steps-container">
                        <!-- Dynamic steps will be added here -->
                    </div>
                    <button type="button" id="edit-add-step-btn" class="btn btn-sm btn-outline-success mt-2">
                        <i class="fas fa-plus"></i> Añadir Paso
                    </button>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                    <button type="submit" class="btn btn-primary">Guardar Cambios</button>
                </div>
            </form>
        </div>
    </div>
</div>


@section Scripts {
    <script>
        $(document).ready(function () {
            function showNotification(message, type, shouldReload) {
                Swal.fire({
                    icon: type,
                    title: type === 'success' ? 'Éxito' : 'Error',
                    text: message,
                    confirmButtonColor: '#3085d6'
                }).then((result) => {
                    if (shouldReload && type === 'success' && result.isConfirmed) {
                        location.reload();
                    }
                });
            }

            // Create Service Logic
            let stepIndex = 0;
            $('#add-step-btn').on('click', function () {
                const container = $('#installation-steps-container');
                const stepHtml = `
                    <div class="row g-2 mb-2 align-items-center" data-step-index="${stepIndex}">
                        <div class="col-auto">
                            <input type="number" name="NewService.InstallationSteps[${stepIndex}].Steps" class="form-control" placeholder="Paso" required style="width: 80px;" />
                        </div>
                        <div class="col">
                            <input type="text" name="NewService.InstallationSteps[${stepIndex}].Description" class="form-control" placeholder="Descripción del paso" required />
                        </div>
                        <div class="col-auto">
                            <button type="button" class="btn btn-sm btn-outline-danger remove-step-btn">
                                <i class="fas fa-times"></i>
                            </button>
                        </div>
                    </div>`;
                container.append(stepHtml);
                stepIndex++;
            });

            $('#installation-steps-container').on('click', '.remove-step-btn', function () {
                $(this).closest('.row').remove();
            });

            $('#createServiceModal').on('hidden.bs.modal', function () {
                $(this).find('form')[0].reset();
                $('#installation-steps-container').empty();
                stepIndex = 0;
            });

            // Edit Service Logic
            let editStepIndex = 0;
            $(document).on('click', '.edit-service-btn', function() {
                var serviceId = $(this).data('id');
                var modal = $('#editServiceModal');

                $.get('@Url.Action("GetService", "Home")?id=' + serviceId)
                    .done(function(service) {
                        modal.find('#edit-service-id').val(service.id);
                        modal.find('#edit-service-name').val(service.name);
                        modal.find('#edit-service-description').val(service.description);

                        const container = modal.find('#edit-installation-steps-container');
                        container.empty();
                        editStepIndex = 0;

                        if (service.installationSteps && service.installationSteps.length > 0) {
                            service.installationSteps.forEach(function(step) {
                                addEditStep(step.id, step.steps, step.description);
                            });
                        }
                        modal.modal('show');
                    })
                    .fail(function() {
                        showNotification("Error al cargar los datos del servicio.", "error");
                    });
            });

            $('#edit-add-step-btn').on('click', function() {
                addEditStep('', '', ''); // Add a new empty step
            });
            
            function addEditStep(id, steps, description) {
                const container = $('#edit-installation-steps-container');
                const stepHtml = `
                    <div class="row g-2 mb-2 align-items-center" data-step-index="${editStepIndex}">
                        <input type="hidden" class="edit-step-id" value="${id}" />
                        <div class="col-auto">
                            <input type="number" class="form-control edit-step-number" placeholder="Paso" value="${steps}" required style="width: 80px;" />
                        </div>
                        <div class="col">
                            <input type="text" class="form-control edit-step-description" placeholder="Descripción del paso" value="${description}" required />
                        </div>
                        <div class="col-auto">
                            <button type="button" class="btn btn-sm btn-outline-danger remove-step-btn">
                                <i class="fas fa-times"></i>
                            </button>
                        </div>
                    </div>`;
                container.append(stepHtml);
                editStepIndex++;
            }

            $('#edit-installation-steps-container').on('click', '.remove-step-btn', function () {
                $(this).closest('.row').remove();
            });

            $('#editServiceForm').on('submit', function(e) {
                e.preventDefault();
                var serviceId = $('#edit-service-id').val();
                
                var installationSteps = [];
                $('#edit-installation-steps-container .row').each(function() {
                    var step = {
                        Id: $(this).find('.edit-step-id').val(),
                        Steps: parseInt($(this).find('.edit-step-number').val(), 10),
                        Description: $(this).find('.edit-step-description').val()
                    };
                    installationSteps.push(step);
                });

                var data = {
                    Name: $('#edit-service-name').val(),
                    Description: $('#edit-service-description').val(),
                    InstallationSteps: installationSteps
                };

                $.ajax({
                    url: '@Url.Action("UpdateService", "Home")?id=' + serviceId,
                    type: 'POST',
                    contentType: 'application/json',
                    data: JSON.stringify(data),
                    success: function(response) {
                        if (response.success) {
                            $('#editServiceModal').modal('hide');
                            showNotification("Servicio actualizado exitosamente.", 'success', true);
                        } else {
                            showNotification(response.message, 'error');
                        }
                    },
                    error: function() {
                        showNotification('Ocurrió un error al conectar con el servidor.', 'error');
                    }
                });
            });
        });
    </script>
}
