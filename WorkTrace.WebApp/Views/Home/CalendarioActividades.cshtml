@model WorkTrace.WebApp.Models.CalendarioActividadesViewModel?
@{
    ViewData["Title"] = "Calendario de Actividades";
}

@section Scripts {
    <link href="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/css/select2.min.css" rel="stylesheet" />
    <script src="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/js/select2.min.js"></script>
    <script src='https://cdn.jsdelivr.net/npm/fullcalendar@6.1.19/index.global.min.js'></script>
    <script src='https://cdn.jsdelivr.net/npm/@@fullcalendar/bootstrap5@6.1.19/index.global.min.js'></script>
    <script src='https://cdn.jsdelivr.net/npm/@@fullcalendar/core/locales-all.global.min.js'></script>

    <script>
        document.addEventListener('DOMContentLoaded', function() {
            var calendarEl = document.getElementById('calendar');
            var events = @Html.Raw(Model?.EventsJson ?? "[]");
            var calendar;

            var userMap = JSON.parse('@Html.Raw(Model?.UsersJson ?? "{}")');
            var clientMap = JSON.parse('@Html.Raw(Model?.ClientsJson ?? "{}")');
            var serviceMap = JSON.parse('@Html.Raw(Model?.ServicesJson ?? "{}")');
            var statusMap = JSON.parse('@Html.Raw(Model?.StatusesJson ?? "{}")');
            var templateMap = JSON.parse('@Html.Raw(Model?.FormTemplatesJson ?? "{}")');

            function showNotification(message, type, shouldReload) {
                Swal.fire({
                    icon: type,
                    title: type === 'success' ? 'Éxito' : 'Error',
                    text: message,
                    confirmButtonColor: '#3085d6'
                }).then((result) => {
                    if (shouldReload && type === 'success' && result.isConfirmed) {
                        location.reload();
                    }
                });
            }

            $('#client, #service, #users, #status').select2({ dropdownParent: $('#createAssignmentModal'), width: '100%' });
            $('#templates').select2({ dropdownParent: $('#createAssignmentModal'), width: '100%', placeholder: 'Seleccione una o varias plantillas...' });
            
            $('#edit-client, #edit-service, #edit-users, #edit-status').select2({ dropdownParent: $('#editAssignmentModal'), width: '100%' });
            $('#edit-templates').select2({ dropdownParent: $('#editAssignmentModal'), width: '100%', placeholder: 'Seleccione una o varias plantillas...' });

            $("#createStatusForm").on("submit", function(e) {
                e.preventDefault();

                const statusData = {
                    name: $('#status-name').val(),
                    description: $('#status-description').val(),
                    isActive: $('#status-isactive').is(':checked')
                };

                $.ajax({
                    url: '@Url.Action("CreateStatus", "Home")',
                    type: 'POST',
                    contentType: 'application/json',
                    data: JSON.stringify(statusData),
                    success: function(response) {
                        if (response.success) {
                            $('#createStatusModal').modal('hide');
                            $("#createStatusForm")[0].reset();
                            showNotification("Estado creado exitosamente.", 'success', true);
                        } else {
                            showNotification(response.message, 'error');
                        }
                    },
                    error: function() {
                        showNotification('Ocurrió un error al conectar con el servidor.', 'error');
                    }
                });
            });

            $("#createAssignmentForm").on("submit", function(e) {
                e.preventDefault();
                const dateVal = $('#date').val();
                const timeVal = $('#time').val();
                const combinedDateTime = new Date(`${dateVal}T${timeVal}`);
                const assignmentData = {
                    users: $('#users').val(),
                    service: $('#service').val(),
                    client: $('#client').val(),
                    status: $('#status').val(),
                    assignedDate: combinedDateTime.toISOString(),
                    address: $('#address').val(),
                    assignedForms: $('#templates').val()
                };
                $.ajax({
                    url: '@Url.Action("CreateAssignment", "Home")',
                    type: 'POST',
                    contentType: 'application/json',
                    data: JSON.stringify(assignmentData),
                    success: function(response) {
                        if (response.success) {
                            var newAssignment = response.data;
                            var statusText = statusMap[newAssignment.status] || "Estado Desconocido";
                            var clientText = clientMap[newAssignment.client] || "Cliente Desconocido";
                            var serviceText = serviceMap[newAssignment.service] || "Servicio Desconocido";
                            var usersText = newAssignment.users.map(userId => userMap[userId] || "Usuario Desconocido");
                            var assignedTemplateIds = newAssignment.assignedTemplateIds || newAssignment.assignedForms || newAssignment.AssignedForms || [];

                            calendar.addEvent({
                                id: newAssignment.id,
                                title: statusText,
                                start: newAssignment.assignedDate,
                                extendedProps: {
                                    client: clientText,
                                    service: serviceText,
                                    users: usersText,
                                    address: newAssignment.address,
                                    status: statusText,
                                    checkIn: newAssignment.checkIn,
                                    checkOut: newAssignment.checkOut,
                                    createdByUser: newAssignment.createdByUser,
                                    assignedTemplateIds: assignedTemplateIds
                                }
                            });
                            
                            $('#createAssignmentModal').modal('hide');
                            $("#createAssignmentForm")[0].reset();
                            $('#client, #service, #users, #status, #templates').val(null).trigger('change');
                            showNotification("Asignación creada exitosamente.", 'success');
                        } else {
                            showNotification(response.message, 'error');
                        }
                    },
                    error: function() {
                        showNotification('Ocurrió un error al conectar con el servidor.', 'error');
                    }
                });
            });

            $("#editAssignmentForm").on("submit", function(e) {
                e.preventDefault();
                const id = $('#edit-assignment-id').val();
                const dateVal = $('#edit-date').val();
                const timeVal = $('#edit-time').val();
                const combinedDateTime = new Date(`${dateVal}T${timeVal}`);

                const assignmentData = {
                    users: $('#edit-users').val(),
                    service: $('#edit-service').val(),
                    client: $('#edit-client').val(),
                    status: $('#edit-status').val(),
                    assignedDate: combinedDateTime.toISOString(),
                    address: $('#edit-address').val(),
                    assignedForms: $('#edit-templates').val()
                };

                $.ajax({
                    url: `@Url.Action("UpdateAssignment", "Home")/${id}`,
                    type: 'PUT',
                    contentType: 'application/json',
                    data: JSON.stringify(assignmentData),
                    success: function(response) {
                        if (response.success) {
                            var updatedAssignment = response.data;
                            var event = calendar.getEventById(updatedAssignment.id);
                            if (event) {
                                event.remove();
                            }

                            var newStatusText = statusMap[assignmentData.status] || "Estado Desconocido";
                            var newClientText = clientMap[assignmentData.client] || "Cliente Desconocido";
                            var newServiceText = serviceMap[assignmentData.service] || "Servicio Desconocido";
                            var newUsersText = assignmentData.users.map(userId => userMap[userId] || "Usuario Desconocido");
                            var assignedTemplateIds = updatedAssignment.assignedTemplateIds || updatedAssignment.assignedForms || updatedAssignment.AssignedForms || [];

                            var newEvent = calendar.addEvent({
                                id: updatedAssignment.id,
                                title: newStatusText,
                                start: updatedAssignment.assignedDate,
                                extendedProps: {
                                    client: newClientText,
                                    service: newServiceText,
                                    users: newUsersText,
                                    address: updatedAssignment.address,
                                    status: newStatusText,
                                    checkIn: updatedAssignment.checkIn,
                                    checkOut: updatedAssignment.checkOut,
                                    createdByUser: updatedAssignment.createdByUser,
                                    assignedTemplateIds: assignedTemplateIds
                                }
                            });
                            
                            // Explicitly set for safety as requested, though addEvent handles it.
                            if(newEvent) {
                                newEvent.setExtendedProp('assignedTemplateIds', assignedTemplateIds);
                            }
                            
                            $('#editAssignmentModal').modal('hide');
                            showNotification("Asignación actualizada exitosamente.", 'success');
                        } else {
                            showNotification(response.message, 'error');
                        }
                    },
                    error: function() {
                        showNotification('Ocurrió un error al conectar con el servidor.', 'error');
                    }
                });
            });

            calendar = new FullCalendar.Calendar(calendarEl, {
                locale: 'es',
                themeSystem: 'bootstrap5',
                headerToolbar: {
                    left: 'prev,next today',
                    center: 'title',
                    right: 'dayGridMonth,timeGridWeek,timeGridDay,listWeek'
                },
                buttonText: { today: 'Hoy', month: 'Mes', week: 'Semana', day: 'Día', list: 'Lista', prev: '<', next: '>' },
                initialView: 'dayGridMonth',
                events: events,
                editable: true,
                eventDrop: function(info) {
                    var event = info.event;
                    var oldEvent = info.oldEvent;
                    var delta = info.delta;

                    // --- SURGICAL FIX for backward drag stretching ---
                    if (oldEvent.end) {
                        var duration = oldEvent.end.getTime() - oldEvent.start.getTime();
                        var newEnd = new Date(event.start.getTime() + duration);
                        if (!event.end || event.end.getTime() !== newEnd.getTime()) {
                            event.setEnd(newEnd);
                        }
                    } else {
                        event.setEnd(null);
                    }
                    // --- END FIX ---

                    var newStartDate = new Date(event.start);
                    newStartDate.setMinutes(newStartDate.getMinutes() - newStartDate.getTimezoneOffset());
                    
                    var assignmentData = {
                        assignedDate: newStartDate.toISOString()
                    };

                    $.ajax({
                        url: `@Url.Action("UpdateAssignment", "Home")/${event.id}`,
                        type: 'PUT',
                        contentType: 'application/json',
                        data: JSON.stringify(assignmentData),
                        error: function(xhr) {
                            alert('Error al actualizar la fecha de la asignación.');
                            info.revert();
                        }
                    });
                },
                eventContent: function(arg) {
                    let container = document.createElement('div');
                    container.style.display = 'flex';
                    container.style.justifyContent = 'space-between';
                    container.style.width = '100%';
                    container.style.alignItems = 'center';

                    let eventTitle = document.createElement('span');
                    eventTitle.innerHTML = arg.event.title;
                    eventTitle.style.overflow = 'hidden';
                    eventTitle.style.textOverflow = 'ellipsis';
                    eventTitle.style.whiteSpace = 'nowrap';
                    eventTitle.style.flexGrow = '1';

                    let editIcon = document.createElement('i');
                    editIcon.classList.add('fas', 'fa-pencil-alt', 'edit-assignment-btn', 'ms-2');
                    editIcon.style.cursor = 'pointer';
                    editIcon.setAttribute('data-id', arg.event.id);

                    container.appendChild(eventTitle);
                    container.appendChild(editIcon);

                    return { domNodes: [container] };
                },
                eventClick: function(info) {
                    if (!$(info.jsEvent.target).hasClass('edit-assignment-btn')) {
                        var props = info.event.extendedProps;
                        var modal = $('#assignmentDetailModal');
                        
                        // Reset Tabs
                        var triggerFirstTabEl = document.querySelector('#assignmentDetailTabs button[data-bs-target="#general-tab-pane"]')
                        bootstrap.Tab.getInstance(triggerFirstTabEl)?.show() || new bootstrap.Tab(triggerFirstTabEl).show();

                        var formatToLocalDateTime = (isoString) => {
                            if (!isoString) return { date: 'No registrado', time: '' };
                            const date = new Date(isoString);
                            
                            if (isNaN(date.getTime())) return { date: 'Inválido', time: '' };

                            const datePart = new Intl.DateTimeFormat('es-ES', {
                                year: 'numeric',
                                month: '2-digit',
                                day: '2-digit'
                            }).format(date);

                            const timePart = new Intl.DateTimeFormat('es-ES', {
                                hour: '2-digit',
                                minute: '2-digit',
                                hour12: false
                            }).format(date);

                            return { date: datePart, time: timePart };
                        };

                        var ci = formatToLocalDateTime(props.checkIn);
                        var co = formatToLocalDateTime(props.checkOut);

                        var userList = props.users && props.users.length > 0 ? '<ul>' + props.users.map(u => `<li>${u}</li>`).join('') + '</ul>' : '<p class="text-muted fst-italic">No hay técnicos asignados.</p>';
                        
                        var assignedTemplatesHtml = '<p class="text-muted fst-italic">No hay plantillas asignadas.</p>';
                        var tIds = props.assignedTemplateIds || props.assignedForms || props.AssignedForms || [];
                        
                        if (tIds && tIds.length > 0) {
                            var listItems = tIds.map(tid => {
                                var name = templateMap[tid] || templateMap[String(tid)] || "Plantilla Desconocida";
                                return `<li>${name}</li>`;
                            }).join('');
                            assignedTemplatesHtml = `<ul>${listItems}</ul>`;
                        } else if (props.assignedTemplates && props.assignedTemplates.length > 0) {
                             assignedTemplatesHtml = '<ul>' + props.assignedTemplates.map(t => `<li>${t}</li>`).join('') + '</ul>';
                        }

                        var bodyContent = `<p><strong><i class="fas fa-user-tie me-2"></i>Cliente:</strong> ${props.client}</p>
                                           <p><strong><i class="fas fa-concierge-bell me-2"></i>Servicio:</strong> ${props.service}</p>
                                           <p><strong><i class="fas fa-map-marker-alt me-2"></i>Dirección:</strong> ${props.address}</p><hr/>
                                           <p><strong><i class="fas fa-calendar-alt me-2"></i>Fecha:</strong> ${info.event.start.toLocaleDateString()}</p>
                                           <p><strong><i class="fas fa-clock me-2"></i>Hora:</strong> ${info.event.start.toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' })}</p><hr/>
                                           <p><strong><i class="fas fa-info-circle me-2"></i>Estado:</strong> <span class="badge bg-primary">${props.status}</span></p>
                                           <div class="row my-2">
                                                <div class="col-6">
                                                    <div class="p-2 border rounded bg-light">
                                                        <h6 class="text-success mb-2"><i class="far fa-calendar-check me-2"></i>Check-In</h6>
                                                        <div class="d-flex flex-column">
                                                            <span class="small text-muted">Fecha</span>
                                                            <span class="fw-bold">${ci.date}</span>
                                                            <span class="small text-muted mt-1">Hora</span>
                                                            <span class="fw-bold">${ci.time || '--:--'}</span>
                                                        </div>
                                                    </div>
                                                </div>
                                                <div class="col-6">
                                                    <div class="p-2 border rounded bg-light">
                                                        <h6 class="text-danger mb-2"><i class="far fa-calendar-times me-2"></i>Check-Out</h6>
                                                        <div class="d-flex flex-column">
                                                            <span class="small text-muted">Fecha</span>
                                                            <span class="fw-bold">${co.date}</span>
                                                            <span class="small text-muted mt-1">Hora</span>
                                                            <span class="fw-bold">${co.time || '--:--'}</span>
                                                        </div>
                                                    </div>
                                                </div>
                                           </div>
                                           <p><strong><i class="fas fa-user-plus me-2"></i>Creado por:</strong> ${userMap[props.createdByUser] || 'No registrado'}</p><hr/>
                                           <p><strong><i class="fas fa-clipboard-list me-2"></i>Plantillas Asignadas:</strong></p>${assignedTemplatesHtml}
                                           <p><strong><i class="fas fa-users me-2"></i>Técnicos Asignados:</strong></p>${userList}`;
                        
                        $('#assignment-general-content').html(bodyContent);

                        // --- POPULATE EVALUATION TAB (AJAX) ---
                        var evalContainer = $('#assignment-evaluation-content');
                        evalContainer.html('<div class="text-center py-4"><div class="spinner-border text-primary" role="status"><span class="visually-hidden">Cargando...</span></div><p class="mt-2 text-muted">Cargando detalles de evaluación...</p></div>');

                        $.ajax({
                            url: '@Url.Action("GetAssignmentEvaluationDetail", "Home")',
                            data: { assignmentId: info.event.id },
                            success: function(response) {
                                if (response && response.success && response.data) {
                                    var d = response.data;
                                    var html = '<div class="container-fluid px-0">';

                                    // 1. Technician's Evidence
                                    html += '<h5 class="fw-bold text-dark mb-3"><i class="fas fa-tools me-2 text-primary"></i>Evidencia del Técnico</h5>';
                                    html += '<div class="card border-0 shadow-sm mb-4 bg-light rounded-3">';
                                    html += '<div class="card-body">';
                                    html += `<p class="mb-3 text-muted"><span class="fw-bold text-dark">Comentario:</span> ${d.userComment || '<span class="fst-italic">Sin comentarios.</span>'}</p>`;
                                    
                                    if (d.mediaFiles && d.mediaFiles.length > 0) {
                                        html += '<div class="row row-cols-2 row-cols-md-3 row-cols-lg-4 g-3">';
                                        d.mediaFiles.forEach(function(media) {
                                            html += `<div class="col">
                                                        <div class="card h-100 border-0 shadow-sm overflow-hidden position-relative group-hover-zoom">
                                                            <a href="${media.url}" target="_blank" class="stretched-link">
                                                                <img src="${media.url}" class="card-img-top w-100 h-100" style="object-fit: cover; min-height: 120px;" alt="Evidencia">
                                                            </a>
                                                            <div class="card-img-overlay d-flex align-items-end p-0">
                                                                <div class="bg-dark bg-opacity-50 text-white w-100 p-1 text-center small opacity-0 hover-opacity-100 transition-opacity">
                                                                    <i class="fas fa-search-plus"></i> Ver
                                                                </div>
                                                            </div>
                                                        </div>
                                                     </div>`;
                                        });
                                        html += '</div>';
                                    } else {
                                        html += '<div class="text-muted fst-italic small"><i class="far fa-image me-1"></i>No hay archivos multimedia adjuntos.</div>';
                                    }
                                    html += '</div></div>';

                                    // 2. Client Conformity (Receipt Style)
                                    html += '<h5 class="fw-bold text-dark mb-3"><i class="fas fa-file-signature me-2 text-primary"></i>Conformidad del Cliente</h5>';
                                    if (d.clientSignature) {
                                        html += `<div class="card border-0 shadow-sm mb-4" style="background-color: #f8f9fa; border-left: 5px solid #198754 !important;">
                                                    <div class="card-body">
                                                        <div class="d-flex justify-content-between align-items-start mb-3">
                                                            <div>
                                                                <h6 class="fw-bold mb-1">Recibo de Conformidad</h6>
                                                                <p class="text-muted small mb-0">Firmado digitalmente</p>
                                                            </div>
                                                            <div class="text-end">
                                                                <span class="badge bg-success bg-opacity-10 text-success border border-success border-opacity-25 rounded-pill px-3">Firmado</span>
                                                            </div>
                                                        </div>
                                                        <p class="mb-3 small text-muted"><span class="fw-bold text-dark">Comentario:</span> ${d.clientComment || '<span class="fst-italic">Sin comentarios.</span>'}</p>
                                                        <div class="text-center p-3 bg-white border border-secondary border-opacity-25 rounded-3" style="border-style: dashed !important;">
                                                            <img src="${d.clientSignature.url}" class="img-fluid" style="max-height: 100px;" alt="Firma del Cliente">
                                                            <div class="mt-2 pt-2 border-top">
                                                                <p class="mb-0 small fw-bold text-dark">${d.clientName || d.clientSignature.signedBy || 'Cliente'}</p>
                                                                <p class="mb-0 x-small text-muted">${new Date(d.clientSignature.signedAt).toLocaleString()}</p>
                                                            </div>
                                                        </div>
                                                    </div>
                                                 </div>`;
                                    } else {
                                        html += '<div class="alert alert-warning border-0 shadow-sm mb-4 rounded-3"><i class="fas fa-exclamation-triangle me-2"></i>El cliente no ha firmado ni expresado conformidad.</div>';
                                    }

                                    // 3. Evaluation Results
                                    html += '<h5 class="fw-bold text-dark mb-3"><i class="fas fa-clipboard-check me-2 text-primary"></i>Resultados de Evaluación</h5>';
                                    
                                    if (d.forms && d.forms.length > 0) {
                                        d.forms.forEach(function(form) {
                                            html += `<div class="card mb-4 border-0 shadow-sm rounded-3 overflow-hidden">
                                                        <div class="card-header bg-white border-bottom py-3">
                                                            <h6 class="mb-0 fw-bold text-primary">${form.formName}</h6>
                                                        </div>
                                                        <div class="card-body p-0">`;
                                            
                                            if (form.userEvaluations && form.userEvaluations.length > 0) {
                                                form.userEvaluations.forEach(function(uEval, uIndex) {
                                                    if(uIndex > 0) html += '<hr class="my-0 bg-light">';
                                                    html += `<div class="p-3">
                                                                <div class="d-flex align-items-center mb-3">
                                                                    <div class="avatar bg-primary bg-opacity-10 text-primary rounded-circle me-2 d-flex align-items-center justify-content-center" style="width: 32px; height: 32px;">
                                                                        <i class="fas fa-user small"></i>
                                                                    </div>
                                                                    <div>
                                                                        <h6 class="mb-0 fw-bold text-dark small">${uEval.userName}</h6>
                                                                    </div>
                                                                </div>`;
                                                    
                                                    if (uEval.answers && uEval.answers.length > 0) {
                                                        html += '<ul class="list-group list-group-flush rounded-3">';
                                                        uEval.answers.forEach(function(ans) {
                                                            var questionText = form.questions.find(q => q.questionKey === ans.questionKey)?.questionText || ans.questionKey;
                                                            var answerDisplay = '';
                                                            
                                                            if (ans.numericValue !== null) {
                                                                // Star Rating display
                                                                var stars = '';
                                                                for(var i=1; i<=5; i++) {
                                                                    if (i <= ans.numericValue) stars += '<i class="fas fa-star text-warning"></i>';
                                                                    else stars += '<i class="far fa-star text-muted opacity-25"></i>';
                                                                }
                                                                answerDisplay = `<div class="text-nowrap" title="${ans.numericValue}/5">${stars}</div>`;
                                                            } else {
                                                                answerDisplay = `<span class="badge bg-secondary bg-opacity-75 fw-normal text-wrap text-start lh-sm">${ans.answer || ans.questionValue || 'N/A'}</span>`;
                                                            }

                                                            html += `<li class="list-group-item d-flex justify-content-between align-items-center bg-light bg-opacity-25 border-bottom-0 py-2">
                                                                        <span class="small text-muted me-3 lh-sm" style="max-width: 65%;">${questionText}</span>
                                                                        ${answerDisplay}
                                                                     </li>`;
                                                        });
                                                        html += '</ul>';
                                                    } else {
                                                        html += '<p class="text-muted fst-italic small ps-4 mb-0">Sin respuestas registradas.</p>';
                                                    }
                                                    html += `</div>`;
                                                });
                                            } else {
                                                html += '<div class="p-3 text-muted fst-italic small">No hay evaluaciones de usuarios para este formulario.</div>';
                                            }

                                            html += `   </div>
                                                     </div>`;
                                        });
                                    } else {
                                        html += '<div class="alert alert-secondary border-0 shadow-sm rounded-3"><i class="fas fa-info-circle me-2"></i>No hay formularios de evaluación registrados.</div>';
                                    }

                                    html += '</div>';
                                    evalContainer.html(html);

                                } else {
                                    evalContainer.html('<div class="alert alert-info"><i class="fas fa-info-circle me-2"></i>Esta asignación aún no tiene detalles de ejecución o evaluación registrados.</div>');
                                }
                            },
                            error: function() {
                                evalContainer.html('<div class="alert alert-danger"><i class="fas fa-exclamation-circle me-2"></i>Error al cargar los detalles de evaluación.</div>');
                            }
                        });

                        modal.modal('show');
                    }
                },
                eventDidMount: function(info) {
                    var props = info.event.extendedProps;
                    if (props && props.client && props.service) {
                        var tooltip = new bootstrap.Tooltip(info.el, {
                            title: props.client + ' - ' + props.service,
                            placement: 'top',
                            trigger: 'hover',
                            container: 'body'
                        });
                    }
                }
            });

            $(document).on('click', '.edit-assignment-btn', function(e) {
                e.stopPropagation();
                var assignmentId = $(this).data('id');
                
                $.get(`@Url.Action("GetAssignment", "Home")?id=${assignmentId}`).done(function (data) {
                    $('#edit-assignment-id').val(data.id);
                    $('#edit-client').val(data.client).trigger('change');
                    $('#edit-service').val(data.service).trigger('change');
                    $('#edit-users').val(data.users).trigger('change');
                    $('#edit-status').val(data.status).trigger('change');
                    $('#edit-address').val(data.address);
                    $('#edit-templates').val(data.assignedTemplateIds || data.assignedForms).trigger('change');
                    
                    var date = new Date(data.assignedDate);
                    var year = date.getFullYear();
                    var month = ('0' + (date.getMonth() + 1)).slice(-2);
                    var day = ('0' + date.getDate()).slice(-2);
                    var hours = ('0' + date.getHours()).slice(-2);
                    var minutes = ('0' + date.getMinutes()).slice(-2);

                    $('#edit-date').val(`${year}-${month}-${day}`);
                    $('#edit-time').val(`${hours}:${minutes}`);
                    
                    $('#editAssignmentModal').modal('show');
                });
            });

            calendar.render();
        });
    </script>
    <style>
        :root { --fc-border-color: #dee2e6; --fc-today-bg-color: rgba(255, 224, 130, 0.2); }
        .fc { font-size: 0.9rem; }
        .fc .fc-toolbar.fc-header-toolbar { margin-bottom: 1.5rem; display: flex; justify-content: space-between; align-items: center; }
        .fc .fc-toolbar-title { font-size: 1.75rem; font-weight: 600; color: #343a40; }
        .fc .fc-prev-button, .fc .fc-next-button { background-color: #fff !important; border: 1px solid #ced4da !important; box-shadow: none !important; color: #495057; border-radius: 50%; width: 40px; height: 40px; font-size: 1.2rem; font-weight: bold; line-height: 1; transition: all 0.2s ease-in-out; }
        .fc .fc-prev-button:hover, .fc .fc-next-button:hover { background-color: #f8f9fa !important; border-color: #adb5bd !important; color: #212529; }
        .fc .fc-today-button { background-color: #f8f9fa; border-color: #dee2e6; color: #212529; font-weight: 600; }
        .fc .fc-button-primary:not(:disabled):active, .fc .fc-button-primary:not(:disabled).fc-button-active { background-color: #0d6efd; border-color: #0d6efd; color: white; }
        .fc .fc-today-button:hover { background-color: #e9ecef; }
        .fc-event { cursor: pointer; }
        .fc-daygrid-event { white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
        .edit-assignment-btn { color: #0d6efd; }
    </style>
}

<div class="container-fluid py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1 class="mb-0">@ViewData["Title"]</h1>
        <div>
            <a asp-action="Index" asp-controller="Home" class="btn btn-secondary"><i class="fas fa-arrow-left me-2"></i>Volver al Panel Principal</a>
            <button type="button" class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#createAssignmentModal"><i class="fas fa-plus me-2"></i>Crear Asignación</button>
            <button type="button" class="btn btn-info" data-bs-toggle="modal" data-bs-target="#createStatusModal"><i class="fas fa-plus me-2"></i>Crear Estado de Servicio</button>
        </div>
    </div>
    <div class="card shadow-sm">
        <div class="card-body">
            <div id='calendar'></div>
        </div>
    </div>
</div>

<!-- Modals -->
<!-- Create Status Modal -->
<div class="modal fade" id="createStatusModal" tabindex="-1" aria-labelledby="createStatusModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <form id="createStatusForm">
                <div class="modal-header">
                    <h5 class="modal-title" id="createStatusModalLabel">Crear Nuevo Estado de Servicio</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <label for="status-name" class="form-label">Nombre</label>
                        <input type="text" id="status-name" name="name" class="form-control" required />
                    </div>
                    <div class="mb-3">
                        <label for="status-description" class="form-label">Descripción</label>
                        <textarea id="status-description" name="description" class="form-control" required></textarea>
                    </div>
                    <div class="form-check mb-3">
                        <input class="form-check-input" type="checkbox" id="status-isactive" name="isactive" checked>
                        <label class="form-check-label" for="status-isactive">
                            Activo
                        </label>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                    <button type="submit" class="btn btn-primary">Crear</button>
                </div>
            </form>
        </div>
    </div>
</div>
<!-- Edit Assignment Modal -->
<div class="modal fade" id="editAssignmentModal" tabindex="-1" aria-labelledby="editAssignmentModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <form id="editAssignmentForm">
                <div class="modal-header">
                    <h5 class="modal-title" id="editAssignmentModalLabel">Editar Asignación</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <input type="hidden" id="edit-assignment-id" />
                    @if (Model != null)
                    {
                        <div class="row gx-3">
                            <div class="col-md-6 mb-3">
                                <label for="edit-client" class="form-label"><i class="fas fa-user-tie me-2 text-secondary"></i>Cliente</label>
                                <select id="edit-client" name="client" class="form-select" required>
                                    <option value="">Seleccione un cliente...</option>
                                    @foreach (var client in Model.Clients) { <option value="@client.Id">@client.FullName</option> }
                                </select>
                            </div>
                            <div class="col-md-6 mb-3">
                                <label for="edit-service" class="form-label"><i class="fas fa-concierge-bell me-2 text-secondary"></i>Servicio</label>
                                <select id="edit-service" name="service" class="form-select" required>
                                    <option value="">Seleccione un servicio...</option>
                                    @foreach (var service in Model.Services) { <option value="@service.Id">@service.Name</option> }
                                </select>
                            </div>
                        </div>
                        <div class="mb-3">
                            <label for="edit-users" class="form-label"><i class="fas fa-users me-2 text-secondary"></i>Asignar Empleado(s)</label>
                            <select id="edit-users" name="users" class="form-select" multiple required>
                                @foreach (var user in Model.Users) { <option value="@user.Id">@user.FullName</option> }
                            </select>
                        </div>
                        <div class="mb-3">
                            <label for="edit-templates" class="form-label"><i class="fas fa-clipboard-list me-2 text-secondary"></i>Plantillas de Formulario</label>
                            <select id="edit-templates" name="templates" class="form-select" multiple>
                                @foreach (var template in Model.FormTemplates) { <option value="@template.Id">@template.Name</option> }
                            </select>
                            <div class="form-text text-muted">Puede seleccionar una o más plantillas.</div>
                        </div>
                        <div class="mb-3">
                            <label for="edit-address" class="form-label"><i class="fas fa-map-marker-alt me-2 text-secondary"></i>Dirección</label>
                            <input type="text" id="edit-address" name="address" class="form-control" required />
                        </div>
                        <div class="row gx-3">
                            <div class="col-md-6 mb-3">
                                <label for="edit-date" class="form-label"><i class="fas fa-calendar-alt me-2 text-secondary"></i>Fecha</label>
                                <input type="date" id="edit-date" name="date" class="form-control" required />
                            </div>
                            <div class="col-md-6 mb-3">
                                <label for="edit-time" class="form-label"><i class="fas fa-clock me-2 text-secondary"></i>Hora</label>
                                <input type="time" id="edit-time" name="time" class="form-control" required />
                            </div>
                        </div>
                        <div class="mb-3">
                            <label for="edit-status" class="form-label"><i class="fas fa-info-circle me-2 text-secondary"></i>Estado</label>
                            <select id="edit-status" name="status" class="form-select" required>
                                <option value="">Seleccione un estado...</option>
                                @foreach (var status in Model.Statuses) { <option value="@status.Id">@status.Name</option> }
                            </select>
                        </div>
                    }
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                    <button type="submit" class="btn btn-primary">Guardar Cambios</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Assignment Detail Modal -->
<div class="modal fade" id="assignmentDetailModal" tabindex="-1" aria-labelledby="assignmentDetailModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="assignmentDetailModalLabel">Detalle de la Asignación</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body p-0">
                 <!-- Tabs -->
                <ul class="nav nav-tabs px-3 pt-3" id="assignmentDetailTabs" role="tablist">
                    <li class="nav-item" role="presentation">
                        <button class="nav-link active" id="general-tab" data-bs-toggle="tab" data-bs-target="#general-tab-pane" type="button" role="tab" aria-controls="general-tab-pane" aria-selected="true">General</button>
                    </li>
                    <li class="nav-item" role="presentation">
                        <button class="nav-link" id="evaluation-tab" data-bs-toggle="tab" data-bs-target="#evaluation-tab-pane" type="button" role="tab" aria-controls="evaluation-tab-pane" aria-selected="false">Ejecución y Evaluación</button>
                    </li>
                </ul>
                <div class="tab-content p-3" id="assignmentDetailTabContent">
                    <div class="tab-pane fade show active" id="general-tab-pane" role="tabpanel" aria-labelledby="general-tab" tabindex="0">
                        <div id="assignment-general-content"></div>
                    </div>
                    <div class="tab-pane fade" id="evaluation-tab-pane" role="tabpanel" aria-labelledby="evaluation-tab" tabindex="0">
                        <div id="assignment-evaluation-content">
                             <div class="text-center py-4">
                                <div class="spinner-border text-primary" role="status">
                                    <span class="visually-hidden">Cargando...</span>
                                </div>
                                <p class="mt-2 text-muted">Cargando detalles de evaluación...</p>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cerrar</button>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="createAssignmentModal" tabindex="-1" aria-labelledby="createAssignmentModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <form id="createAssignmentForm">
                <div class="modal-header">
                    <h5 class="modal-title" id="createAssignmentModalLabel">Crear Nueva Asignación</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    @if (Model != null)
                    {
                        <div class="row gx-3">
                            <div class="col-md-6 mb-3">
                                <label for="client" class="form-label"><i class="fas fa-user-tie me-2 text-secondary"></i>Cliente</label>
                                <select id="client" name="client" class="form-select" required>
                                    <option value="" disabled selected>Seleccione un cliente...</option>
                                    @foreach (var client in Model.Clients) { <option value="@client.Id">@client.FullName</option> }
                                </select>
                            </div>
                            <div class="col-md-6 mb-3">
                                <label for="service" class="form-label"><i class="fas fa-concierge-bell me-2 text-secondary"></i>Servicio</label>
                                <select id="service" name="service" class="form-select" required>
                                    <option value="" disabled selected>Seleccione un servicio...</option>
                                    @foreach (var service in Model.Services) { <option value="@service.Id">@service.Name</option> }
                                </select>
                            </div>
                        </div>
                        <div class="mb-3">
                            <label for="users" class="form-label"><i class="fas fa-users me-2 text-secondary"></i>Asignar Empleado(s)</label>
                            <select id="users" name="users" class="form-select" multiple required>
                                @foreach (var user in Model.Users) { <option value="@user.Id">@user.FullName</option> }
                            </select>
                        </div>
                        <div class="mb-3">
                            <label for="templates" class="form-label"><i class="fas fa-clipboard-list me-2 text-secondary"></i>Plantillas de Formulario</label>
                            <select id="templates" name="templates" class="form-select" multiple>
                                @foreach (var template in Model.FormTemplates) { <option value="@template.Id">@template.Name</option> }
                            </select>
                            <div class="form-text text-muted">Puede seleccionar una o más plantillas.</div>
                        </div>
                        <div class="mb-3">
                            <label for="address" class="form-label"><i class="fas fa-map-marker-alt me-2 text-secondary"></i>Dirección</label>
                            <input type="text" id="address" name="address" class="form-control" placeholder="Ingrese la dirección" required />
                        </div>
                        <div class="row gx-3">
                            <div class="col-md-6 mb-3">
                                <label for="date" class="form-label"><i class="fas fa-calendar-alt me-2 text-secondary"></i>Fecha</label>
                                <input type="date" id="date" name="date" class="form-control" required />
                            </div>
                            <div class="col-md-6 mb-3">
                                <label for="time" class="form-label"><i class="fas fa-clock me-2 text-secondary"></i>Hora</label>
                                <input type="time" id="time" name="time" class="form-control" required />
                            </div>
                        </div>
                        <div class="mb-3">
                            <label for="status" class="form-label"><i class="fas fa-info-circle me-2 text-secondary"></i>Estado</label>
                            <select id="status" name="status" class="form-select" required>
                                <option value="" disabled selected>Seleccione un estado...</option>
                                @foreach (var status in Model.Statuses) { <option value="@status.Id">@status.Name</option> }
                            </select>
                        </div>
                    }
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                    <button type="submit" class="btn btn-primary">Crear</button>
                </div>
            </form>
        </div>
    </div>
</div>
