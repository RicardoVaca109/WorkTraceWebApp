@model List<WorkTrace.WebApp.Models.Dtos.TakenRequirement.TakenRequirementResponse>

@{
    ViewData["Title"] = "Requerimientos";
}

<style>
    @@import url('https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap');

    body {
        background-color: #f4f6f9;
        font-family: 'Inter', sans-serif;
        color: #343a40;
    }

    .dashboard-container {
        padding: 40px;
        min-height: 85vh;
        max-width: 1600px;
        margin: 0 auto;
    }

    .dashboard-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 40px;
        padding-bottom: 20px;
        border-bottom: 1px solid #e9ecef;
    }

    .header-title-group {
        display: flex;
        align-items: center;
        gap: 15px;
    }

    .header-title {
        font-size: 1.75rem;
        font-weight: 700;
        color: #212529;
        margin: 0;
        letter-spacing: -0.5px;
    }

    .header-subtitle {
        color: #6c757d;
        font-size: 0.95rem;
        margin-top: 5px;
        font-weight: 400;
    }

    .filter-controls {
        display: flex;
        gap: 12px;
        align-items: center;
    }

    .form-select-custom {
        border: 1px solid #ced4da;
        border-radius: 6px;
        padding: 8px 12px;
        font-size: 0.9rem;
        color: #495057;
        background-color: #fff;
        box-shadow: 0 1px 2px rgba(0,0,0,0.05);
        cursor: pointer;
        transition: border-color 0.15s ease-in-out, box-shadow 0.15s ease-in-out;
    }

    .form-select-custom:focus {
        border-color: #80bdff;
        outline: 0;
        box-shadow: 0 0 0 0.2rem rgba(0,123,255,.25);
    }

    .btn-create {
        background-color: #0d6efd;
        color: white;
        border: none;
        border-radius: 6px;
        padding: 8px 16px;
        font-weight: 500;
        font-size: 0.9rem;
        display: flex;
        align-items: center;
        gap: 8px;
        transition: background-color 0.2s, box-shadow 0.2s;
        box-shadow: 0 2px 4px rgba(13, 110, 253, 0.2);
    }

    .btn-create:hover {
        background-color: #0b5ed7;
        box-shadow: 0 4px 8px rgba(13, 110, 253, 0.3);
        color: white;
    }

    .btn-back {
        border: 1px solid #ced4da;
        color: #6c757d;
        display: flex;
        align-items: center;
        gap: 8px;
        text-decoration: none;
        padding: 8px 16px;
        border-radius: 6px;
        font-weight: 500;
        font-size: 0.9rem;
        transition: all 0.2s;
        background-color: transparent;
    }

    .btn-back:hover {
        background-color: #6c757d;
        color: #ffffff;
        border-color: #6c757d;
    }

    /* Grid Layout */
    .cards-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
        gap: 24px;
    }

    /* Info Card Design */
    .info-card {
        background-color: #ffffff;
        border-radius: 8px;
        box-shadow: 0 2px 6px rgba(0,0,0,0.04);
        padding: 24px;
        height: 260px; /* Fixed height for consistency */
        display: flex;
        flex-direction: column;
        position: relative;
        transition: transform 0.2s ease, box-shadow 0.2s ease;
        border-left: 4px solid #dee2e6; /* Default border */
        cursor: default;
        overflow: hidden;
    }

    .info-card:hover {
        transform: translateY(-4px);
        box-shadow: 0 10px 20px rgba(0,0,0,0.08);
    }

    /* Status Strip Colors */
    .info-card.yellow { border-left-color: #f59e0b; } /* Warning/Orange */
    .info-card.blue { border-left-color: #3b82f6; }   /* Primary/Blue */
    .info-card.green { border-left-color: #10b981; }  /* Success/Green */
    .info-card.pink { border-left-color: #ec4899; }   /* Accent/Pink */

    .info-card-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 16px;
    }

    .info-card-date {
        font-size: 0.75rem;
        text-transform: uppercase;
        letter-spacing: 0.5px;
        color: #adb5bd;
        font-weight: 600;
    }

    .info-card-title {
        font-size: 1.15rem;
        font-weight: 600;
        color: #212529;
        margin-bottom: 10px;
        line-height: 1.4;
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
        overflow: hidden;
    }

    .info-card-body {
        font-size: 0.925rem;
        color: #6c757d;
        line-height: 1.6;
        flex-grow: 1;
        overflow-y: auto;
        margin-bottom: 12px;
        /* Custom Scrollbar */
        scrollbar-width: thin;
        scrollbar-color: #e9ecef transparent;
    }

    .info-card-body::-webkit-scrollbar {
        width: 4px;
    }
    .info-card-body::-webkit-scrollbar-track {
        background: transparent;
    }
    .info-card-body::-webkit-scrollbar-thumb {
        background-color: #e9ecef;
        border-radius: 4px;
    }

    /* Footer / Edit Icon */
    .info-card-footer {
        margin-top: auto;
        padding-top: 12px;
        border-top: 1px solid #f8f9fa;
        display: flex;
        justify-content: flex-end;
    }

    .btn-edit-card {
        background: none;
        border: none;
        color: #adb5bd;
        cursor: pointer;
        padding: 4px 8px;
        font-size: 0.95rem;
        transition: color 0.2s, background-color 0.2s;
        border-radius: 4px;
    }

    .btn-edit-card:hover {
        color: #495057;
        background-color: #f8f9fa;
    }

    /* Modal Styling for Consistency */
    .modal-content {
        border-radius: 12px;
        border: none;
        box-shadow: 0 15px 35px rgba(0,0,0,0.1);
    }
    
    .modal-header {
        background-color: #fff;
        border-bottom: 1px solid #f0f2f5;
        padding: 24px;
        border-radius: 12px 12px 0 0;
    }

    .modal-title {
        font-weight: 600;
        color: #212529;
    }

    .modal-body {
        padding: 24px;
    }

    .form-label {
        font-weight: 500;
        font-size: 0.9rem;
        color: #495057;
        margin-bottom: 6px;
    }

    .form-control, .form-select {
        border-radius: 6px;
        border: 1px solid #dee2e6;
        padding: 10px 12px;
        font-size: 0.95rem;
    }

    .form-control:focus, .form-select:focus {
        border-color: #80bdff;
        box-shadow: 0 0 0 3px rgba(13, 110, 253, 0.1);
    }

    .modal-footer {
        padding: 16px 24px;
        background-color: #f8f9fa;
        border-top: 1px solid #f0f2f5;
        border-radius: 0 0 12px 12px;
    }
</style>

<div class="dashboard-container">
    <!-- Header -->
    <div class="dashboard-header">
        <div class="header-title-group">
            <div>
                <h2 class="header-title">Requerimientos</h2>
                <div class="header-subtitle">Gestión y seguimiento de solicitudes</div>
            </div>
        </div>
        
        <div class="filter-controls">
            <a asp-action="Index" asp-controller="Home" class="btn-back">
                <i class="fas fa-arrow-left"></i> Volver al Panel Principal
            </a>
            <select id="monthFilter" class="form-select-custom">
                <option value="">Todos los Meses</option>
                <option value="1">Enero</option>
                <option value="2">Febrero</option>
                <option value="3">Marzo</option>
                <option value="4">Abril</option>
                <option value="5">Mayo</option>
                <option value="6">Junio</option>
                <option value="7">Julio</option>
                <option value="8">Agosto</option>
                <option value="9">Septiembre</option>
                <option value="10">Octubre</option>
                <option value="11">Noviembre</option>
                <option value="12">Diciembre</option>
            </select>
            
            <button class="btn-create" data-bs-toggle="modal" data-bs-target="#createModal">
                <i class="fas fa-plus"></i> Nuevo
            </button>
        </div>
    </div>

    <!-- Grid -->
    <div class="cards-grid" id="notesContainer">
        @foreach (var item in Model)
        {
            <div class="info-card" data-id="@item.Id" data-client-id="@item.ClientId" data-iso-date="@item.Date.ToString("O")">
                <div class="info-card-header">
                    <span class="info-card-date">@item.Date.ToString("dd MMM yyyy")</span>
                </div>
                <div class="info-card-title">@item.Title</div>
                <div class="info-card-body">@item.Description</div>
            </div>
        }
    </div>
</div>

<!-- Create Modal -->
<div class="modal fade" id="createModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Nuevo Requerimiento</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <form id="createForm">
                    <input type="hidden" id="createUserId" value="@ViewBag.CurrentUserId" />
                    
                    <div class="mb-3">
                        <label for="createClientId" class="form-label">Cliente</label>
                        <select class="form-select" id="createClientId" required>
                            <option value="">Seleccione un cliente...</option>
                            @if (ViewBag.Clients != null)
                            {
                                foreach (var client in ViewBag.Clients)
                                {
                                    <option value="@client.Id">@client.FullName</option>
                                }
                            }
                        </select>
                    </div>

                    <div class="mb-3">
                        <label for="createTitle" class="form-label">Título</label>
                        <input type="text" class="form-control" id="createTitle" required placeholder="Resumen corto...">
                    </div>

                    <div class="mb-3">
                        <label for="createDescription" class="form-label">Descripción</label>
                        <textarea class="form-control" id="createDescription" rows="4" required placeholder="Detalles del requerimiento..."></textarea>
                    </div>
                </form>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-light text-secondary" data-bs-dismiss="modal">Cancelar</button>
                <button type="button" class="btn btn-primary" onclick="submitCreate()">Guardar</button>
            </div>
        </div>
    </div>
</div>

<!-- Edit Modal Injected -->
<div class="modal fade" id="editModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Editar Requerimiento</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <form id="editForm">
                    <input type="hidden" id="editId" />
                    
                    <div class="mb-3">
                        <label for="editClientId" class="form-label">Cliente</label>
                        <select class="form-select" id="editClientId" required>
                            <option value="">Seleccione un cliente...</option>
                            @if (ViewBag.Clients != null)
                            {
                                foreach (var client in ViewBag.Clients)
                                {
                                    <option value="@client.Id">@client.FullName</option>
                                }
                            }
                        </select>
                    </div>

                    <div class="mb-3">
                        <label for="editTitle" class="form-label">Título</label>
                        <input type="text" class="form-control" id="editTitle" required>
                    </div>

                    <div class="mb-3">
                        <label for="editDescription" class="form-label">Descripción</label>
                        <textarea class="form-control" id="editDescription" rows="4" required></textarea>
                    </div>
                </form>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-light text-secondary" data-bs-dismiss="modal">Cancelar</button>
                <button type="button" class="btn btn-primary" onclick="submitEdit()">Actualizar</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // Edit Logic Injected
        document.addEventListener('DOMContentLoaded', function() {
            // Randomize note colors (now status strips) and Inject Edit Icon
            const colors = ['yellow', 'blue', 'green', 'pink'];
            
            // Selector updated to .info-card (was .post-it)
            $('.info-card').each(function() {
                const $note = $(this);

                // --- Local Time Logic ---
                const isoDate = $note.attr('data-iso-date');
                if (isoDate) {
                    const date = new Date(isoDate);
                    if (!isNaN(date.getTime())) {
                        // 1. Update Display Date (e.g., "15 Ene 2026")
                        const displayDate = new Intl.DateTimeFormat('es-ES', { 
                            day: 'numeric', 
                            month: 'short', 
                            year: 'numeric' 
                        }).format(date);
                        
                        // Selector updated to .info-card-date (was .post-it-date)
                        $note.find('.info-card-date').text(displayDate);

                        // 2. Update Filter Date Attribute (yyyy-MM-dd) for the Month Filter
                        const year = date.getFullYear();
                        const month = String(date.getMonth() + 1).padStart(2, '0');
                        const day = String(date.getDate()).padStart(2, '0');
                        $note.attr('data-date', `${year}-${month}-${day}`);
                    }
                }
                // -----------------------------
                
                // Random Color (Now applies Left Border class)
                const randomColor = colors[Math.floor(Math.random() * colors.length)];
                $note.addClass(randomColor);

                // Inject Edit Icon (Footer)
                const $footer = $('<div class="info-card-footer"></div>');
                // Replaced logic with new classes
                const $editBtn = $('<button class="btn-edit-card" title="Editar"><i class="fas fa-pen"></i></button>');
                
                $editBtn.on('click', function(e) {
                    e.stopPropagation(); // Prevent triggering click if any
                    openEditModal($note);
                });

                $footer.append($editBtn);
                $note.append($footer);
            });

            // Filter Logic
            $('#monthFilter').on('change', function() {
                const selectedMonth = $(this).val();
                
                // Selector updated to .info-card
                $('.info-card').each(function() {
                    const $note = $(this);
                    if (selectedMonth === "") {
                        $note.css('display', 'flex');
                    } else {
                        const dateStr = $note.attr('data-date'); // yyyy-MM-dd
                        if (!dateStr) return;
                        
                        const month = parseInt(dateStr.split('-')[1]);
                        
                        if (month.toString() === selectedMonth) {
                            $note.css('display', 'flex');
                        } else {
                            $note.css('display', 'none');
                        }
                    }
                });
            });
        });

        // PRESERVED AJAX LOGIC -----------------------

        function submitCreate() {
            const userId = $('#createUserId').val();
            const clientId = $('#createClientId').val();
            const title = $('#createTitle').val();
            const description = $('#createDescription').val();

            if (!clientId || !title || !description) {
                Swal.fire('Error', 'Por favor complete todos los campos', 'warning');
                return;
            }

            const data = {
                userId: userId,
                clientId: clientId,
                title: title,
                description: description
            };

            $.ajax({
                url: '/Home/CreateTakenRequirement',
                type: 'POST',
                contentType: 'application/json',
                data: JSON.stringify(data),
                success: function(res) {
                    if (res.success) {
                        Swal.fire('Éxito', 'Nota creada correctamente', 'success').then(() => {
                            location.reload();
                        });
                    } else {
                        Swal.fire('Error', res.message, 'error');
                    }
                },
                error: function() {
                    Swal.fire('Error', 'Error de conexión', 'error');
                }
            });
        }

        function openEditModal($note) {
            // Extract data
            const id = $note.attr('data-id');
            const clientId = $note.attr('data-client-id');
            // Selectors updated to match new classes
            const title = $note.find('.info-card-title').text();
            const description = $note.find('.info-card-body').text();

            // Populate Modal
            $('#editId').val(id);
            $('#editClientId').val(clientId);
            $('#editTitle').val(title);
            $('#editDescription').val(description);

            // Show Modal
            const modal = new bootstrap.Modal(document.getElementById('editModal'));
            modal.show();
        }

        function submitEdit() {
            const id = $('#editId').val();
            const clientId = $('#editClientId').val();
            const title = $('#editTitle').val();
            const description = $('#editDescription').val();

            if (!clientId || !title || !description) {
                Swal.fire('Error', 'Por favor complete todos los campos', 'warning');
                return;
            }

            const data = {
                id: id,
                clientId: clientId,
                title: title,
                description: description
            };

            $.ajax({
                url: '/TakenRequirements/Update',
                type: 'PUT',
                contentType: 'application/json',
                data: JSON.stringify(data),
                success: function(res) {
                    if (res.success) {
                        Swal.fire('Éxito', 'Nota actualizada correctamente', 'success').then(() => {
                            location.reload();
                        });
                    } else {
                        Swal.fire('Error', res.message, 'error');
                    }
                },
                error: function() {
                    Swal.fire('Error', 'Error de conexión', 'error');
                }
            });
        }
    </script>
}